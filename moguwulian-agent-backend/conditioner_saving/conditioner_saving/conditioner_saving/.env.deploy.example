# ============================================================
# HVAC Energy Agent 服务器部署环境变量模板
# 用法: cp .env.deploy.example .env 后逐项填写；或直接运行
#       ./scripts/deploy_server.sh 自动生成/补全（推荐）。
# 说明: compose 会把本文件的变量注入容器；必填项缺失时
#       docker compose 会拒绝启动（:? 语法强制）。
# ============================================================

# ---- 身份签名密钥（必填）----
# proxy 的 COOKIE_SECRET 与 api 的 AUTH_SECRET 必须为同一值。
# 生成方式: openssl rand -hex 32
AUTH_SECRET=

# ---- 服务器地址（必填）----
# 浏览器可达的公网/局域网地址，不带末尾斜杠，如 http://192.168.1.100
# 要求：浏览器与容器都能访问该地址（部署脚本用它派生下方回调变量）
PUBLIC_BASE_URL=

# ---- OIDC 登录（必填；默认用内置迷你测试 IdP）----
# 测试 IdP 的 issuer 即其根地址（无路径）；浏览器与容器都要能访问该端口。
# 宿主机端口默认 8081，被占用时用 OIDC_PORT=xxx 改（下方两处同步改）
OIDC_PORT=8081
OAUTH_SERVER_URL=http://<SERVER>:8081
REDIRECT_URI=http://<SERVER>:8080/oauth2callback
CLIENT_ID=hvac-proxy
CLIENT_SECRET=hvac-proxy-secret
# 测试账号固定为 test / test123456（角色 sr = API 特权角色）
# 切换生产 IdP（Casdoor 等）时覆盖以上四项：
# OAUTH_SERVER_URL 必须等于 IdP 的 issuer 全称（Casdoor 为其根地址）

# ---- 数据库（可选）----
POSTGRES_PASSWORD=hvac_dev_password

# ---- LLM（可选）----
# 不填则 agent 自动降级为零成本规则策略（deterministic 模式可完整跑通业务）
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ---- 其他（可选）----
# 生产同源 BFF 模式下浏览器不跨域，一般留空即可
CORS_ALLOW_ORIGINS=
