# Anthropic API Key for Claude Agent SDK
# 获取方式: https://console.anthropic.com/settings/keys
# 注意: 确定性技能（空调提取/质检/填充建议）已不需要 Key，零 LLM 可跑；
#       仅空压提取、仿真、Agent LLM 模式需要。
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_BASE_URL=          # 可选：自建 LLM 代理（生产必须 HTTPS）
# ANTHROPIC_MODEL=             # 可选：模型名

# ---- 平台底座（M1+）----
# DATABASE_URL=                # 默认 SQLite(data/app.db)，生产用 postgresql+psycopg2://...
# REDIS_URL=                   # 可选：SSE 事件经 Pub/Sub（多副本部署时配置）
# REQUIRE_AUTH=true            # 生产必须开启：强制网关身份头 + 会话归属校验
# AUTH_SECRET=<随机长随机串>    # 生产必须设置：身份头 HMAC-SHA256 签名密钥，
#                              # 必须与 proxy 的 COOKIE_SECRET 一致；
#                              # 未设置时身份头可被客户端伪造（启动横幅会告警）
# CORS_ALLOW_ORIGINS=https://your-site.example.com   # 生产必须显式设置（逗号分隔）
# LLM_DAILY_TOKEN_BUDGET=500000                       # 每用户日 token 预算
